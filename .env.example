# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore) — c'est sans danger d'y
# mettre de vraies clés en local. Sur Vercel, renseignez ces mêmes variables
# dans Project Settings > Environment Variables (jamais en clair ailleurs).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète — accès complet, contourne RLS. Serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys) ---
# Utilisez les clés "test" (sk_test_..., pk_test_...) tant que vous n'avez
# pas terminé la vérification manuelle du parcours complet.
STRIPE_SECRET_KEY=
# Créé automatiquement par `stripe listen` en local, ou dans
# Developers > Webhooks une fois l'endpoint ajouté, en production.
STRIPE_WEBHOOK_SECRET=
# ID du prix récurrent "Facilo Pro" (Produits > Facilo Pro > API ID du prix).
STRIPE_PRICE_ID=
# Optionnel — ID d'un Promotion Code Stripe verrouillant le tarif de
# lancement pour les inscrits de la liste d'attente. Laissez vide sinon.
STRIPE_WAITLIST_PROMO_CODE=

# --- Resend (Phase 3 — pas encore utilisé en Phase 1) ---
RESEND_API_KEY=

# --- App ---
# URL publique de cette app (utilisée dans les redirections Stripe/Auth).
# En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret partagé pour protéger la route de cron (Phase 3).
CRON_SECRET=
